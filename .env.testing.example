APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost

# Default PHPUnit di repo ini memakai SQLite in-memory (lihat phpunit.xml).
# Pastikan ekstensi PHP: php8.x-sqlite3 / pdo_sqlite (Debian: apt install php8.4-sqlite3).
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4

OPENROUTER_API_KEY=testing-dummy-key
