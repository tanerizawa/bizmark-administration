APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost

# Gunakan database terpisah untuk testing (JANGAN pakai bizmark_db production).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bizmark_test
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4

# Dummy keys untuk service eksternal supaya test tidak hit real API.
OPENROUTER_API_KEY=testing-dummy-key
