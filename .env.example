APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Secret path untuk admin-only login terpisah (bypass unified /login).
# Kosongkan untuk menonaktifkan. Ganti secara periodik untuk keamanan.
# Contoh: ADMIN_SECRET_PATH=e3f31ac4e84c4b86
ADMIN_SECRET_PATH=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bizmark_db
DB_USERNAME=bizmark_user
DB_PASSWORD=
# For Docker: DB_HOST=db

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=tls

# Mailgun (jika MAIL_MAILER=mailgun)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

EMAIL_WEBHOOK_SECRET=
EMAIL_WEBHOOK_DEFAULT_RECIPIENT=info@bizmark.id
EMAIL_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
EMAIL_WEBHOOK_REQUIRE_SIGNATURE=false
EMAIL_WEBHOOK_ALLOWED_IPS=
EMAIL_WEBHOOK_REPLAY_PROTECTION_ENABLED=true
EMAIL_WEBHOOK_TIMESTAMP_HEADER=X-Timestamp
EMAIL_WEBHOOK_NONCE_HEADER=X-Nonce
EMAIL_WEBHOOK_MAX_AGE_SECONDS=300
EMAIL_WEBHOOK_MAX_FUTURE_SKEW_SECONDS=30
EMAIL_WEBHOOK_NONCE_TTL_SECONDS=86400
EMAIL_WEBHOOK_CACHE_STORE=redis
EMAIL_WEBHOOK_RESPONSE_CACHE_TTL_SECONDS=86400
EMAIL_WEBHOOK_CACHE_LATENCY_WARN_MS=50
EMAIL_WEBHOOK_ALERT_THRESHOLD_PER_HOUR=10
INTERNAL_API_KEY=
TWO_FACTOR_ENABLED=true
TWO_FACTOR_GRACE_DAYS=7
TWO_FACTOR_TRUST_DAYS=30
TWO_FACTOR_TRUST_COOKIE=two_factor_trust
TWO_FACTOR_SESSION_KEY=two_factor_verified_at

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OpenRouter AI (konsultasi & premium client portal)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_TOKENS=4096
# Free tier (cost-optimized)
OPENROUTER_FREE_PRIMARY_MODEL=google/gemini-2.5-flash
OPENROUTER_FREE_FALLBACK_MODEL=deepseek/deepseek-v3.2
# Premium tier (quality-optimized)
OPENROUTER_PREMIUM_PRIMARY_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_PREMIUM_FALLBACK_MODEL=google/gemini-2.5-flash

# Perizinan AI RAG Integration (internal API)
PERIZINAN_AI_URL=https://api.bizmark.id
PERIZINAN_AI_USERNAME=
PERIZINAN_AI_PASSWORD=
PERIZINAN_AI_TIMEOUT=30

# SearXNG (internal search engine untuk AI)
SEARXNG_URL=http://127.0.0.1:8888

# PWA / Web Push Notifications (VAPID)
VAPID_SUBJECT=mailto:cs@bizmark.id
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google SEO & Analytics
GOOGLE_TAG_MANAGER_ID=
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GSC_SITE_URL=
GBP_LOCATION_ID=
GBP_REFRESH_TOKEN=

# Facebook
FACEBOOK_PIXEL_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Twitter / X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# Medium
MEDIUM_INTEGRATION_TOKEN=

# Dev.to
DEVTO_API_KEY=

# Telegram (notifikasi/channel posting)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Pexels (gambar otomatis untuk artikel)
PEXELS_API_KEY=

# SEO Auto-Post
SITEMAP_ENABLED=true
SOCIAL_POSTING_FREE_ONLY=false

VITE_APP_NAME="${APP_NAME}"

# Observability
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
PULSE_ENABLED=true
